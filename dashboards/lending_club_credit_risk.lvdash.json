{
  "datasets": [
    {
      "name": "4040d523",
      "displayName": "Headline",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  MAX(CASE WHEN model = 'LightGBM'               THEN roc_auc END) AS model_auc,\n  MAX(CASE WHEN model = 'Lending Club sub-grade' THEN roc_auc END) AS grade_auc,\n  MAX(CASE WHEN model = 'LightGBM'               THEN ks      END) AS model_ks,\n  (SELECT COUNT(*) FROM workspace.lending_club.gold_predictions WHERE split = 'test') AS test_loans\nFROM workspace.lending_club.gold_model_comparison\nWHERE split = 'test'",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "dcd793d3",
      "displayName": "Model Comparison",
      "config": {
        "version": "1.1",
        "source": "SELECT model,\n       ROUND(roc_auc, 4) AS auc,\n       ROUND(gini, 4)    AS gini,\n       ROUND(ks, 4)      AS ks,\n       ROUND(pr_auc, 4)  AS pr_auc,\n       ROUND(brier, 4)   AS brier\nFROM workspace.lending_club.gold_model_comparison\nWHERE split = 'test'\nORDER BY roc_auc DESC",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "16517b6b",
      "displayName": "Loan Selection",
      "config": {
        "version": "1.1",
        "source": "SELECT funded_share_pct,\n       model_net_return_pct AS `Model (LightGBM)`,\n       grade_net_return_pct AS `Lending Club sub-grade`,\n       return_advantage_pts\nFROM workspace.lending_club.gold_loan_selection\nORDER BY funded_share_pct",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "e82d494f",
      "displayName": "Calibration",
      "config": {
        "version": "1.1",
        "source": "SELECT decile,\n       predicted_pd_pct   AS `Predicted default %`,\n       actual_default_pct AS `Actual default %`\nFROM workspace.lending_club.gold_calibration\nORDER BY decile",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "4468f261",
      "displayName": "Risk bands",
      "config": {
        "version": "1.1",
        "source": "SELECT risk_band,\n       loans,\n       avg_predicted_pd_pct,\n       actual_default_pct,\n       avg_interest_rate,\n       net_return_pct\nFROM workspace.lending_club.gold_risk_bands\nORDER BY risk_band",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "b02cd41a",
      "displayName": "Grades",
      "config": {
        "version": "1.1",
        "source": "SELECT grade,\n       COUNT(*)                         AS loans,\n       ROUND(100 * AVG(is_default), 1)  AS actual_default_pct,\n       ROUND(AVG(int_rate), 2)          AS avg_interest_rate\nFROM workspace.lending_club.gold_predictions\nWHERE split = 'test'\nGROUP BY grade\nORDER BY grade",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "bfadc2ad",
      "displayName": "Feature Importance",
      "config": {
        "version": "1.1",
        "source": "SELECT feature,\n       share_pct      AS `SHAP share %`,\n       gain_share_pct AS `Gain share %`\nFROM workspace.lending_club.gold_shap_importance\nORDER BY mean_abs_shap DESC\nLIMIT 15",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "167729f5",
      "displayName": "Expected Loss",
      "config": {
        "version": "1.1",
        "source": "SELECT lgd_pct,\n       funded_total,\n       expected_loss,\n       actual_loss,\n       expected_loss_pct_of_funded,\n       actual_loss_pct_of_funded\nFROM workspace.lending_club.gold_expected_loss",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "e86e57c8",
      "displayName": "Reason Codes",
      "config": {
        "version": "1.1",
        "source": "SELECT example, loan_id, predicted_pd_pct, rank, feature, feature_value, shap_log_odds\nFROM workspace.lending_club.gold_reason_codes\nORDER BY predicted_pd_pct, rank",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
